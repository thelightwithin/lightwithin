---
interface Props {
  text: string; // may contain <u>, <em>
}
const { text } = Astro.props;
// unique clip-path id per instance (two statements can share a page)
const uid = 'fol-' + Math.random().toString(36).slice(2, 8);
---

<section class="statement">
  <p class="fx" set:html={text} />
  <!-- flower of life -->
  <svg class="tri fx" style="--d:.25s" viewBox="0 0 80 80" aria-hidden="true">
    <defs>
      <clipPath id={uid}><circle cx="40" cy="40" r="28.8"></circle></clipPath>
    </defs>
    <g clip-path={`url(#${uid})`}>
      <circle cx="10" cy="40" r="10"></circle>
      <circle cx="15" cy="48.66" r="10"></circle>
      <circle cx="20" cy="57.32" r="10"></circle>
      <circle cx="25" cy="65.98" r="10"></circle>
      <circle cx="15" cy="31.34" r="10"></circle>
      <circle cx="20" cy="40" r="10"></circle>
      <circle cx="25" cy="48.66" r="10"></circle>
      <circle cx="30" cy="57.32" r="10"></circle>
      <circle cx="35" cy="65.98" r="10"></circle>
      <circle cx="20" cy="22.68" r="10"></circle>
      <circle cx="25" cy="31.34" r="10"></circle>
      <circle cx="30" cy="40" r="10"></circle>
      <circle cx="35" cy="48.66" r="10"></circle>
      <circle cx="40" cy="57.32" r="10"></circle>
      <circle cx="45" cy="65.98" r="10"></circle>
      <circle cx="25" cy="14.02" r="10"></circle>
      <circle cx="30" cy="22.68" r="10"></circle>
      <circle cx="35" cy="31.34" r="10"></circle>
      <circle cx="40" cy="40" r="10"></circle>
      <circle cx="45" cy="48.66" r="10"></circle>
      <circle cx="50" cy="57.32" r="10"></circle>
      <circle cx="55" cy="65.98" r="10"></circle>
      <circle cx="35" cy="14.02" r="10"></circle>
      <circle cx="40" cy="22.68" r="10"></circle>
      <circle cx="45" cy="31.34" r="10"></circle>
      <circle cx="50" cy="40" r="10"></circle>
      <circle cx="55" cy="48.66" r="10"></circle>
      <circle cx="60" cy="57.32" r="10"></circle>
      <circle cx="45" cy="14.02" r="10"></circle>
      <circle cx="50" cy="22.68" r="10"></circle>
      <circle cx="55" cy="31.34" r="10"></circle>
      <circle cx="60" cy="40" r="10"></circle>
      <circle cx="65" cy="48.66" r="10"></circle>
      <circle cx="55" cy="14.02" r="10"></circle>
      <circle cx="60" cy="22.68" r="10"></circle>
      <circle cx="65" cy="31.34" r="10"></circle>
      <circle cx="70" cy="40" r="10"></circle>
    </g>
    <circle cx="40" cy="40" r="30"></circle>
  </svg>
</section>
