---
import { withBase } from '../utils/url';

interface Props {
  headline: string; // may contain <br>, <em>
  tagline: string;
  ctaLabel: string;
  ctaHref: string;
}
const { headline, tagline, ctaLabel, ctaHref } = Astro.props;
---

<section class="hero grain">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-photo-layer plx" data-plx="0.05">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={withBase('/images/hero/soul-wisdom-hero.jpg')}
      >
        <source src={withBase('/images/hero/soul-wisdom-hero.mp4')} type="video/mp4" />
      </video>
    </div>
    <div class="haze"></div>
  </div>
  <div class="hero-inner plx" data-plx="-0.14">
    <h1 class="rise" set:html={headline} />
    <p class="rise">{tagline}</p>
    <div class="rise"><a class="btn" href={withBase(ctaHref)}>{ctaLabel}</a></div>
  </div>
</section>
