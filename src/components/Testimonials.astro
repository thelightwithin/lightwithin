---
import { getCollection } from 'astro:content';
import site from '../data/site.yaml';
import { withBase } from '../utils/url';

interface Props {
  /** The big vertical title next to the rotating quotes. */
  bandTitle?: string;
}
const { bandTitle = 'Reviews' } = Astro.props;

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
const items = testimonials.map((t) => ({
  label: t.data.label,
  quote: t.data.quote,
  cite: t.data.cite,
}));
---

<section class="testimonials" id="voices">
  <div class="testi-wrap">
    <div class="testi-photo grain fx-img">
      <img src={withBase('/images/reviews/review-session.png')} alt="A glowing thank-you note surrounded by a heart of light" loading="lazy" decoding="async" />
    </div>
    <div class="testi-title fx plx" data-plx="-0.05" aria-hidden="true">{bandTitle}</div>
    <div class="testi-col">
      <div class="testi-viewport" data-review-carousel>
        <div class="testi-track">
          {
            items.map((item, index) => (
              <article class="testi-slide" aria-hidden={index === 0 ? 'false' : 'true'}>
                <span class="caps testi-label">{item.label}</span>
                <div class="testi-quote">
                  {
                    item.quote
                      .split(/\n+/)
                      .map((paragraph) => paragraph.trim())
                      .filter(Boolean)
                      .map((paragraph) => <p>{paragraph}</p>)
                  }
                </div>
                <span class="caps testi-cite">{item.cite}</span>
              </article>
            ))
          }
        </div>
      </div>
      <div class="arrows testi-nav fx" style="--d:.3s" aria-label="Review navigation">
        <button type="button" data-review-prev aria-label="Previous review" disabled={items.length < 2}>←</button>
        <span class="caps testi-count" aria-live="polite">{items.length ? `1 / ${items.length}` : '0 / 0'}</span>
        <button type="button" data-review-next aria-label="Next review" disabled={items.length < 2}>→</button>
      </div>
      {
        site.reviewCta && (
          <div class="testi-more fx" style="--d:.4s">
            <a class="btn" href={withBase(site.reviewCta.href)}>{site.reviewCta.label}</a>
          </div>
        )
      }
      <div class="testi-book fx" style="--d:.5s">
        <a class="btn" href={withBase(site.bookingLink)}>{site.bookingLabel}</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-review-carousel]').forEach((viewport) => {
    const track = viewport.querySelector<HTMLElement>('.testi-track');
    const slides = Array.from(viewport.querySelectorAll<HTMLElement>('.testi-slide'));
    const column = viewport.closest<HTMLElement>('.testi-col');
    const prev = column?.querySelector<HTMLButtonElement>('[data-review-prev]');
    const next = column?.querySelector<HTMLButtonElement>('[data-review-next]');
    const count = column?.querySelector<HTMLElement>('.testi-count');

    if (!track || !prev || !next || !count || slides.length < 2) return;

    let index = 0;

    const syncViewportHeight = () => {
      viewport.style.height = `${slides[index].offsetHeight}px`;
    };

    const showReview = (nextIndex: number) => {
      index = (nextIndex + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, slideIndex) => {
        slide.setAttribute('aria-hidden', String(slideIndex !== index));
      });
      count.textContent = `${index + 1} / ${slides.length}`;
      syncViewportHeight();
    };

    syncViewportHeight();

    const resizeObserver = new ResizeObserver(syncViewportHeight);
    slides.forEach((slide) => resizeObserver.observe(slide));

    prev.addEventListener('click', () => showReview(index - 1));
    next.addEventListener('click', () => showReview(index + 1));
  });
</script>
