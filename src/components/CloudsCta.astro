---
import { withBase } from '../utils/url';

interface Props {
  text?: string;
  image?: string;
  ctaLabel: string;
  ctaHref: string;
}
const { text, image, ctaLabel, ctaHref } = Astro.props;
---

<section class:list={['cta-clouds', { 'has-photo': image }]}>
  <div class="scene plx" data-plx="0.5">
    {
      image ? (
        <img class="cta-photo" src={withBase(image)} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="cloud-layer"></div>
      )
    }
  </div>
  <div class="cta-inner">
    {text && <p class="fx">{text}</p>}
    <a
      class="btn fx"
      style="--d:.2s"
      href={withBase(ctaHref)}
      target={ctaHref.startsWith('http') ? '_blank' : undefined}
      rel={ctaHref.startsWith('http') ? 'noopener' : undefined}>{ctaLabel}</a
    >
  </div>
</section>
